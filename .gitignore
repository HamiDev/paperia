# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker WordPress mount — ignore core, keep the Paperia theme trackable
/wordpress/*
!/wordpress/wp-content/
/wordpress/wp-content/*
!/wordpress/wp-content/themes/
/wordpress/wp-content/themes/*
!/wordpress/wp-content/themes/paperia/

# Configuration & runtime
wp-config.php
**/wp-config.php
*.log
/.htaccess
/wordpress/.htaccess

# Uploads (media stays local / on server)
/wordpress/wp-content/uploads/

# Compiled Sass maps / caches (keep compiled CSS if you choose to commit it)
**/*.css.map
.sass-cache/
